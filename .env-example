# Copy to ".env" on your local WAMP machine only. Do not deploy this file.

# Blank-password login: only works on localhost when this is 1
LIEO_LOCAL_DEV=1

# Plant / department used when seeding local test users
LIEO_LOCAL_PLANT=RCP
LIEO_LOCAL_DEPT=Maintenance

# Mail mode (localhost only — live always sends real mail):
#   local=1  → show test-mail popup, do NOT call SMTP
#   local=0  → send real email via emailSMTP.php
local=1
